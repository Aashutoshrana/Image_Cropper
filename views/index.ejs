    <script>
        const widthInput = document.querySelector('[name="width"]');
        const heightInput = document.querySelector('[name="height"]');
        const widthValue = document.getElementById('width-value');
        const heightValue = document.getElementById('height-value');
        const resizeImage = document.getElementById('resized-image');
        const downloadLink = document.getElementById("download-link");
    
        function updateWidthValue() {
            widthValue.textContent = widthInput.value;
            resizeImagePreview();
        }
    
        function updateHeightValue() {
            heightValue.textContent = heightInput.value;
            resizeImagePreview();
        }
    
        function resizeImagePreview() {
            const formData = new FormData();
            formData.append("width", widthInput.value);
            formData.append("height", heightInput.value);
    
            const imageFile = document.querySelector('[name="image"]').files[0];
            if (imageFile) {
                formData.append("image", imageFile);
            }
    
            fetch('/resize', {
                method: "POST",
                body: formData
            })
            .then((response) => {
                if (!response.ok) {
                    throw new Error('Failed to resize image');
                }
                return response.blob();
            })
            .then((blob) => {
                const objectUrl = URL.createObjectURL(blob);
                resizeImage.src = objectUrl;
                downloadLink.href = objectUrl;
                downloadLink.style.display = "block";
            })
            .catch((err) => {
                console.error(err);
                resizeImage.src = '';  // Reset the image if there's an error
                downloadLink.style.display = "none";
            });
        }
    
        // Add event listeners for sliders
        widthInput.addEventListener('input', updateWidthValue);
        heightInput.addEventListener('input', updateHeightValue);
    </script>
    

</body>
</html>
